GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
CHARACTER_REF_DIR=static/characters
# No true "unlimited" TTL exists on Gemini's caching API -- 24h is a
# practical stand-in for "don't worry about it for the event." Push higher
# (days/weeks) if you want; storage cost at this content size is trivial
# either way, and analyze_and_match() self-heals if it ever expires mid-run.
GEMINI_CACHE_TTL=86400s

OPENAI_API_KEY=your_openai_api_key
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=medium
OPENAI_INPUT_MAX_DIM=1280
OPENAI_OUTPUT_FORMAT=jpeg
OPENAI_OUTPUT_COMPRESSION=85

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=movie-booth-uploads
# Auto-delete sweep is opt-in -- set to true if you ever need the bucket
# kept bounded. POST /booth/admin/cleanup always works for a manual sweep
# regardless of this setting.
SUPABASE_CLEANUP_ENABLED=false
SUPABASE_CLEANUP_AGE_HOURS=6
SUPABASE_CLEANUP_INTERVAL_S=3600

GMAIL_ADDRESS=your_gmail_address@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
EMAIL_FROM_NAME=AI Movie Booth
